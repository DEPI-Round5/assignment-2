ign:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; Console.Write("Enter a number: ");</span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.15;height:12pt;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal"></span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.25;orphans:2;widows:2;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; int num = int.Parse(Console.ReadLine());</span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.25;orphans:2;widows:2;height:12pt;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal"></span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.25;orphans:2;widows:2;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; if (num % 3 == 0 &amp;&amp; num % 4 == 0)</span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.15;height:12pt;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal"></span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.25;orphans:2;widows:2;text-align:left"><span style=