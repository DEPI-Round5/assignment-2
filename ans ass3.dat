an style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal"></span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.25;orphans:2;widows:2;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; string input = Console.ReadLine();</span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.15;height:12pt;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal"></span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.25;orphans:2;widows:2;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; string[] parts = input.Split(new char[] { ',', ' ' }, StringSplitOptions.RemoveEmptyEntries);</span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.25;orphans:2;widows:2;height:12pt;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal"></span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.25;orphans:2;widows:2;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; int a = int.Parse(parts[0]);</span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.15;height:12pt;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal"></span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.25;orphans:2;widows:2;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; int b = int.Parse(parts[1]);</span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.15;height:12pt;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal"></span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.25;orphans:2;widows:2;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; int c = int.Parse(parts[2]);</span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.25;orphans:2;widows:2;height:12pt;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal"></span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.25;orphans:2;widows:2;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; int max = Math.Max(a, Math.Max(b, c));</span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.15;height:12pt;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal"></span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.25;orphans:2;widows:2;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; int min = Math.Min(a, Math.Min(b, c));</span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.25;orphans:2;widows:2;height:12pt;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal"></span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.25;orphans:2;widows:2;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; Console.WriteLine("max element = " + max);</span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.15;height:12pt;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal"></span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.25;orphans:2;widows:2;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; Console.WriteLine("min element = " + min);</span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.15;height:12pt;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal"></span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.25;orphans:2;widows:2;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal">&nbsp; &nbsp; &nbsp; &nbsp; }</span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.15;height:12pt;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal"></span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.25;orphans:2;widows:2;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal">&nbsp; &nbsp; }</span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.15;height:12pt;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal"></span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.25;orphans:2;widows:2;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal">}</span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.15;height:12pt;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal"></span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.25;orphans:2;widows:2;text-align:left"><span style="font-weight:700">Explanation:</span><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal">&nbsp;We split the input string to read the 3 numbers, then use Math.Max and Math.Min to easily find the largest and smallest values.</span></p><h1 id="h.wtt3b7ppa2wq" style="padding-top:24pt;margin:0;color:#2c3e50;font-weight:700;padding-left:0;font-size:18pt;padding-bottom:6pt;line-height:1.25;page-break-after:avoid;font-family:&quot;Lexend&quot;;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#2c3e50;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:18pt;font-family:&quot;Lexend&quot;;font-style:normal">Question 4: Check if a number is even or odd</span></h1><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.25;orphans:2;widows:2;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal">using System;</span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.25;orphans:2;widows:2;height:12pt;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal"></span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.25;orphans:2;widows:2;text-align:left"><span style="color:#2d3436;font-weight:400;text-d