6;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; for (int i = 0; i &lt; n; i++)</span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.15;height:12pt;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal"></span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.25;orphans:2;widows:2;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; {</span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.15;height:12pt;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal"></span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.25;orphans:2;widows:2;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; arr[i] = int.Parse(inputs[i]);</span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.15;height:12pt;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal"></span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.25;orphans:2;widows:2;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; }</span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.25;orphans:2;widows:2;height:12pt;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal"></span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.25;orphans:2;widows:2;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; int maxDistance = 0;</span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.25;orphans:2;widows:2;height:12pt;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal"></span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.25;orphans:2;widows:2;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; for (int i = 0; i &lt; n; i++)</span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.15;height:12pt;text-align:left"><span style="color:#2d3436;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:&quot;Inter&quot;;font-style:normal"></span></p><p style="padding:0;margin:0;color:#2d3436;font-size:12pt;font-family:&quot;Inter&quot;;line-height:1.25;orphans:2;widows:2;text-align:left"><sp